{
  // Backend package TypeScript configuration for Cloudflare Workers
  // Extends root tsconfig and adds Workers-specific settings
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    // Workers 런타임 전역(ExecutionContext, ScheduledController, R2Bucket,
    // KVNamespace, D1Database...). 이게 없으면 types/env.ts의 바인딩 타입부터
    // 크론 핸들러 시그니처까지 "이름을 찾을 수 없음"으로 떨어집니다.
    "types": ["@cloudflare/workers-types"],
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@golf-gps/shared": ["../../shared/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
