# Golf GPS Backend - 환경변수 설정
# 프로덕션/스테이징 배포에는 wrangler secret을 사용하세요.
# 로컬 개발 환경에서만 이 파일을 사용합니다.

# Supabase 프로젝트 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API 설정
API_VERSION=v1
LOG_LEVEL=debug
ENVIRONMENT=development

# R2 (선택사항)
# R2_BUCKET_NAME=golf-gps-photos

# KV Namespace (선택사항)
# KV_NAMESPACE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 웹 푸시 VAPID 키
# node scripts/generate-vapid-keys.mjs 로 한 번 생성해서 붙여넣으세요.
# 키를 바꾸면 기존 구독이 전부 무효가 되므로 한 번 정하면 유지해야 합니다.
VAPID_PUBLIC_KEY=B...87-chars-of-base64url...
VAPID_PRIVATE_KEY=...43-chars-of-base64url...
VAPID_SUBJECT=mailto:ops@example.com

# 관리자 발송 키 (POST /api/push/send의 X-Admin-Key 헤더)
ADMIN_API_KEY=change-me-to-a-long-random-string
