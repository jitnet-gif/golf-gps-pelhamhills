# API Configuration
VITE_API_URL=http://localhost:8787
VITE_API_TIMEOUT=10000

# 티 시트 예약 서버 (FastAPI, backend/api/routes/tee_sheet.py). 위의 Worker 와는
# **다른 백엔드**입니다 - /book 화면만 이 주소를 씁니다.
# 반드시 버전 접두사(/api/v1)까지 포함하세요.
#
# 비워 두면 로컬 개발에서는 http://localhost:8000/api/v1 로 붙고, 배포된 사이트
# 에서는 "예약 불가 + 프로 샵 전화번호" 화면이 됩니다 (localhost 가 박힌 채로
# 배포되어 방문자 브라우저가 자기 8000 포트를 두드리는 사고를 막습니다).
#
# 이 앱은 예약 서버와 출처가 다르므로 FastAPI 쪽 ALLOWED_ORIGINS 에 이 앱의
# 주소(개발은 http://localhost:5173)가 들어 있어야 합니다.
# VITE_TEE_SHEET_API_URL=http://localhost:8000/api/v1

# Supabase
# The publishable key is meant to ship in the client - row-level security, not
# secrecy, is what protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# PWA Configuration
VITE_PWA_ENABLED=true
# Documents the value hardcoded in vite.config.ts - nothing reads this yet.
VITE_PWA_CACHE_TILE_MAX_ENTRIES=800
VITE_PWA_CACHE_API_MAX_ENTRIES=50

# GPS Configuration
VITE_GPS_ENABLE_HIGH_ACCURACY=true
VITE_GPS_TIMEOUT=10000
VITE_GPS_MAX_AGE=0

# Map Configuration
# Basemap tiles. Default is Esri World Imagery (satellite); Leaflet needs a
# {z}/{x}/{y} template and Esri serves {z}/{y}/{x}.
VITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_MAP_DEFAULT_ZOOM=16
VITE_MAP_MIN_ZOOM=14
VITE_MAP_MAX_ZOOM=20

# App Configuration
VITE_APP_NAME=Golf GPS
VITE_APP_VERSION=1.0.0

# Push Notifications
# 웹 푸시 구독/해지는 Worker 백엔드(VITE_API_URL)를 거칩니다.
# 배포 환경에서는 VITE_API_URL이 실제 Worker 주소를 가리켜야 알림을 켤 수 있습니다.
# (배너는 Supabase에 직접 붙으므로 Worker 없이도 동작합니다.)
#
# 공개키는 보통 비워 두세요. 서버가 GET /api/push/vapid-public-key로 알려주므로
# 여기에 박아 두면 서버 키를 바꿨을 때 두 값이 어긋나 발송만 조용히 실패합니다.
# VITE_VAPID_PUBLIC_KEY=

# Feature Flags
VITE_FEATURE_LEADERBOARD=false
VITE_FEATURE_MULTIPLAYER=false
VITE_FEATURE_CAMERA=false
