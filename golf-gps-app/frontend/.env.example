# API Configuration
VITE_API_URL=http://localhost:8787
VITE_API_TIMEOUT=10000

# R2 Bucket (Cloudflare) Configuration
VITE_R2_BUCKET_URL=https://your-r2-bucket.r2.cloudflarestorage.com
VITE_R2_REGION=auto

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_PWA_CACHE_TILE_MAX_ENTRIES=500
VITE_PWA_CACHE_API_MAX_ENTRIES=50

# GPS Configuration
VITE_GPS_ENABLE_HIGH_ACCURACY=true
VITE_GPS_TIMEOUT=10000
VITE_GPS_MAX_AGE=0

# Map Configuration
VITE_MAP_DEFAULT_ZOOM=16
VITE_MAP_MIN_ZOOM=14
VITE_MAP_MAX_ZOOM=20

# App Configuration
VITE_APP_NAME=Golf GPS
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_FEATURE_LEADERBOARD=false
VITE_FEATURE_MULTIPLAYER=false
VITE_FEATURE_CAMERA=false
