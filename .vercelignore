# vercel deploy uploads this directory as-is (no git repo here, so .gitignore
# is not consulted). Everything below must never ride along.

# Secrets. Root .env.local holds the ElevenLabs key; frontend/.env.local pins
# VITE_API_URL to localhost:8787, which Vite would bake into the production
# bundle if this file were uploaded.
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*

# Pre-downloaded tile pyramid + coverage mosaic - regenerated by
# download_tiles.py, served from R2, not from the deployment.
tiles/
tiles_preview.jpg

# Python build noise
__pycache__/
*.pyc

# Build outputs (Vercel builds from source)
frontend/dist/
backend/dist/
shared/dist/

.vercel
