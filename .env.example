# Frontend Environment Variables
# Public variables (prefixed with VITE_) are exposed to the browser
VITE_API_URL=http://localhost:8787

# Backend Environment Variables
# Cloudflare D1 Database URL
CF_DATABASE_URL=file:./data.sqlite

# Cloudflare R2 (Object Storage) Configuration
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CF_R2_BUCKET_NAME=golf-gps-photos

# 계정 ID. R2 개요 페이지에 있고, S3 엔드포인트
# https://<account>.r2.cloudflarestorage.com 를 만드는 데 씁니다.
CF_R2_ACCOUNT_ID=your_cloudflare_account_id_here
# 위성 타일 전용 버킷. 사진 버킷과 분리합니다 - 타일은 1년 immutable 캐시로
# 공개하지만 사용자 사진은 그러면 안 되고, 버킷 정책은 하나뿐입니다.
# scripts: download_tiles.py -> upload_to_r2.py
CF_R2_TILES_BUCKET=golf-gps-tiles

# Third-party API Keys
# ElevenLabs - 홀 나레이션 mp3를 굽는 scripts/generate-narration.mjs 에서만 씁니다.
# 빌드 타임 전용이라 브라우저로 나가지 않습니다. 실제 키는 .env.local 에 두세요.
# text_to_speech 권한만 있으면 됩니다.
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
# 기본값을 바꾸고 싶을 때만. 기본: George / eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Maps / Geolocation API (optional, if using for course mapping)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Configuration (optional, if using for additional data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development Configuration
NODE_ENV=development
DEBUG=golf-gps:*

# Wrangler Cloudflare Configuration
# These are automatically handled by wrangler.toml
# but can be overridden here for local development
